// ai.advisorsai/service-navigator
// Generated: 5 tools, 5 read-only (exposed), 0 mutating, 0 undeclared.
instructions {
    text "Read-only service discovery, public-page checks, and request-link preparation."
}
mcp-upstream "ai.advisorsai/service-navigator" {
    url "https://advisorsai.ai/mcp"
    transport streamable-http
    // Machine-readable, so a consumer can filter on it rather than
    // parse the comments above.
    annotation-coverage declared annotated=5 silent=0
    // readOnlyHint: true, declared by the upstream
    can advisors_catalog_list_services
    can advisors_catalog_get_service
    can advisors_catalog_match_service
    can advisors_site_check_basics
    can advisors_order_prepare_link
}
