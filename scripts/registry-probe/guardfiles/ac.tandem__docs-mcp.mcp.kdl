// ac.tandem/docs-mcp
// Generated: 13 tools, 7 read-only (exposed), 0 mutating, 6 undeclared.
instructions {
    text "Remote MCP server for Tandem docs, install guides, SDKs, workflows, and agent setup help."
}
mcp-upstream "ac.tandem/docs-mcp" {
    url "https://tandem.ac/mcp"
    transport streamable-http
    // Machine-readable, so a consumer can filter on it rather than
    // parse the comments above.
    annotation-coverage partial annotated=7 silent=6
    // readOnlyHint: true, declared by the upstream
    can search_docs
    can get_doc
    can get_start_path
    can recommend_next_docs
    can answer_how_to
    can get_tandem_guide
    can get_docs_cache_status
 // Not exposed: 0 declared mutating, 6 undeclared.
    // Names deliberately omitted, see annotation-coverage above.
}
