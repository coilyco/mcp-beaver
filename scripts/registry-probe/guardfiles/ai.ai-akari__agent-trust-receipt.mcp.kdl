// ai.ai-akari/agent-trust-receipt
// Generated: 2 tools, 1 read-only (exposed), 1 mutating, 0 undeclared.
instructions {
    text "Read-only Remote MCP for externally grounded AI agent trust receipts."
}
mcp-upstream "ai.ai-akari/agent-trust-receipt" {
    url "https://ai-akari.ai/mcp-trust"
    transport streamable-http
    // Machine-readable, so a consumer can filter on it rather than
    // parse the comments above.
    annotation-coverage declared annotated=2 silent=0
    // readOnlyHint: true, declared by the upstream
    can get_agent_trust_receipt
 // Not exposed: 1 declared mutating, 0 undeclared.
    // Names deliberately omitted, see annotation-coverage above.
}
