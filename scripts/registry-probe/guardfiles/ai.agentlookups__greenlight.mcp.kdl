// ai.agentlookups/greenlight
// Generated: 2 tools, 2 read-only (exposed), 0 mutating, 0 undeclared.
instructions {
    text "US plug-in solar (balcony solar) law registry with a daily UL 3700 certification watch."
}
mcp-upstream "ai.agentlookups/greenlight" {
    url "https://solar.agentlookups.ai/mcp"
    transport streamable-http
    // Machine-readable, so a consumer can filter on it rather than
    // parse the comments above.
    annotation-coverage declared annotated=2 silent=0
    // readOnlyHint: true, declared by the upstream
    can solar_states
    can solar_law
}
