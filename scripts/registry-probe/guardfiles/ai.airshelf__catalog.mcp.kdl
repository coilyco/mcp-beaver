// ai.airshelf/catalog
// Generated: 8 tools, 6 read-only (exposed), 2 mutating, 0 undeclared.
instructions {
    text "Cross-vendor B2B catalog for AI agents: search, compare, find equivalents, request a quote."
}
mcp-upstream "ai.airshelf/catalog" {
    url "https://mcp.airshelf.ai/mcp"
    transport streamable-http
    // Machine-readable, so a consumer can filter on it rather than
    // parse the comments above.
    annotation-coverage declared annotated=8 silent=0
    // readOnlyHint: true, declared by the upstream
    can search_catalog
    can find_products
    can get_product
    can compare_products
    can explain_product
    can list_merchants
 // Not exposed: 2 declared mutating, 0 undeclared.
    // Names deliberately omitted, see annotation-coverage above.
}
