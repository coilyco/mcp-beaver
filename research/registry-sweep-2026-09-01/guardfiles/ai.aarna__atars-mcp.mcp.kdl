// ai.aarna/atars-mcp - generated from the MCP registry and a live tools/list.
// 18 tools: 0 declared read-only, 0 declared mutating,
// 18 undeclared. Only declared read-only tools are exposed.
wrap mcp upstream "ai.aarna/atars-mcp" {
    url "https://mcp.aarna.ai/mcp"
    transport streamable-http
    // Machine-readable, so a consumer can filter on it rather than
    // parse the comments above.
    annotation-coverage undeclared annotated=0 silent=18
    instructions {
        text "Crypto market signals, technical indicators, and sentiment analysis for AI agents."
    }
 // Not exposed: 0 declared mutating, 18 undeclared.
    // Names deliberately omitted, see annotation-coverage above.
}
