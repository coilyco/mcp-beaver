// ai.agentlookups/groundtruth - generated from the MCP registry and a live tools/list.
// 3 tools: 0 declared read-only, 0 declared mutating,
// 3 undeclared. Only declared read-only tools are exposed.
wrap mcp upstream "ai.agentlookups/groundtruth" {
    url "https://env.agentlookups.ai/mcp"
    transport streamable-http
    // Machine-readable, so a consumer can filter on it rather than
    // parse the comments above.
    annotation-coverage undeclared annotated=0 silent=3
    instructions {
        text "Federal environmental records near any US location, with dates and provenance; never a safety score."
    }
 // Not exposed: 0 declared mutating, 3 undeclared.
    // Names deliberately omitted, see annotation-coverage above.
}
