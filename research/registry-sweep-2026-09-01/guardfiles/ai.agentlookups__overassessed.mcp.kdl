// ai.agentlookups/overassessed - generated from the MCP registry and a live tools/list.
// 1 tools: 0 declared read-only, 0 declared mutating,
// 1 undeclared. Only declared read-only tools are exposed.
wrap mcp upstream "ai.agentlookups/overassessed" {
    url "https://overassessed.agentlookups.ai/mcp"
    transport streamable-http
    // Machine-readable, so a consumer can filter on it rather than
    // parse the comments above.
    annotation-coverage undeclared annotated=0 silent=1
    instructions {
        text "Maryland property-assessment fairness checks vs similar homes, with appeal windows and links."
    }
 // Not exposed: 0 declared mutating, 1 undeclared.
    // Names deliberately omitted, see annotation-coverage above.
}
