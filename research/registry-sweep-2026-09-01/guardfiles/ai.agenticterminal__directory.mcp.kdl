// ai.agenticterminal/directory - generated from the MCP registry and a live tools/list.
// 6 tools: 0 declared read-only, 0 declared mutating,
// 6 undeclared. Only declared read-only tools are exposed.
wrap mcp upstream "ai.agenticterminal/directory" {
    url "https://mcp.agenticterminal.ai/mcp"
    transport streamable-http
    // Machine-readable, so a consumer can filter on it rather than
    // parse the comments above.
    annotation-coverage undeclared annotated=0 silent=6
    instructions {
        text "Verified merchants accepting agentic payments on Lightning/L402/BOLT12/USDT — search, verify, pay."
    }
 // Not exposed: 0 declared mutating, 6 undeclared.
    // Names deliberately omitted, see annotation-coverage above.
}
