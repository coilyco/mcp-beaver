// guardfile-siblings.mcp.kdl - the worked reference for the nodes that ride
// BESIDE `wrap`: `instructions`, `server-info`, `cache`, `withhold`, `confirm`,
// `resource`, `prompt`, `app`.
//
// `opcore.ParseInline` reads only the `wrap` node, so none of these touch the
// frozen inline grammar or the umbra pin. Every one fails closed. All are
// opt-in except `server-info`, which is on by default. See docs/guardfile-siblings.md.

// What THIS server is for, published in the initialize handshake under the
// shared policy sentence every generated server carries. That sentence says
// how to treat any guarded surface, which is why it cannot tell two of them
// apart - this is where a guardfile says which one you reached.
//
// Keep it short. A consumer that renders instructions into the model's prompt
// pays for them every turn, once per rostered server. Over 500 characters is a
// build error rather than a silent cost. Omit the node and the server
// publishes exactly the shared sentence, as it did before this existed.
instructions {
    text "Things owned by a coilyco-* account on the internal things API."
    text "Reach for it to look up one thing by id, or to file a new one."
    text "It reads and writes things only: no owners, no billing, no deletes."
}

// One read-only tool reporting this server's own shape. Also the liveness
// probe clients lost when MCP 2026-07-28 removed the protocol-level `ping`.
//
// Stating this node changes nothing - it is on by default, and it is written
// out here to be read rather than to switch anything on. Use
// `server-info name="status"` to rename the tool, or `server-info disabled`
// to drop it.
server-info

// A per-server, process-wide outbound bucket. The pod has ONE IP, so a
// public-good upstream sees one caller whose request rate is the sum of every
// user behind this server. Calls queue rather than being rejected: a slower
// tool call beats a failed turn. Omit the node for no limit at all.
rate-limit "1/1s"

// Reuse one grant's upstream answer for a window. Off by default and opt-in
// per grant, because how stale an answer may be is a property of the upstream
// that no default can guess. This is NOT the `ttlMs` on list results, which
// caches the tool inventory rather than the data.
//
// A rate limit bounds the rate and can only make a tool refuse. A cache is the
// one control that lowers a metered bill without lowering capability, which is
// why it sits OUTSIDE the limiter: a hit spends no slot.
//
// Keyed on the tool plus its arguments. Failed calls are never stored, and
// caching a destructive or `confirm`-gated grant is a build error.
cache "get_thing" ttl="15m"

// An empty answer is indistinguishable from a real one once it reaches a
// model, which posts blank messages rather than saying it found nothing.
// Off by default: a search with no hits is a correct empty answer, and only
// the author knows which this is. `false` and `0` are never refused.
reject-empty "get_thing"

// The mirror, and a separate control: that one refuses an answer carrying
// nothing, this refuses a WRITE that would carry nothing. A blank write
// succeeds everywhere, so a lane posted four fully empty messages into a
// shared channel with every layer reporting success (sirens-echo#1035).
// Per field, because emptiness is legitimate for some inputs and a control
// that refuses a write should say exactly what it refuses. A field that is
// absent is the grant's error to report; this catches present-and-blank.
reject-empty-argument "create_thing" field="title"

// State a verb that is left out ON PURPOSE, so an agent stops inferring from
// silence. Absence otherwise means four things at once - withheld by policy,
// unimplemented, not offered upstream, or simply not matched by the agent's
// search - and the guesses go wrong in both directions. The stub appears in
// discovery, refuses every call, and reaches no upstream. Naming a tool this
// spec DOES mint is an error.
withhold "delete_thing" {
    reason "Deletion is withheld on this surface: the upstream has no undo, and nothing here needs it."
    alternative "create_thing"
}

// Gate the one mutation behind a Multi Round-Trip Request. The first call
// returns an input request instead of acting; the tool runs only on a retry
// carrying an explicit accept. Named by PROJECTED TOOL NAME, not by grant.
confirm "create_thing" message="This creates a thing upstream. Continue?"

// Static content, served on resources/read and rendered as an `@` mention in
// Claude Code. Inline only: a resource that proxied an upstream read would be
// a second egress path beside the grants.
// `audience` and `priority` are what an agent harness reads to decide whether
// to pull this into a model's context unprompted. Without the annotation a
// gating harness sees content meant for a human and skips it.
resource "oncall-runbook" uri="beaver://runbook/oncall" mime="text/markdown" priority=0.8 {
    audience "assistant"
    description "First response when this upstream starts 5xx-ing"
    text "1. Call mcp_beaver_info and confirm the pod is serving its tools."
    text "2. Check the upstream's own status page before touching the pod."
    text "3. Escalate rather than retrying a write that already 5xx'd."
}

// A message template, served on prompts/get and rendered as a slash command in
// Claude Code. `{service}` is substituted from the argument; omitting a
// required argument is an error rather than an empty substitution.
prompt "triage" title="Triage an incident" {
    description "Walk the on-call first-response steps for this upstream"
    argument "service" description="Which service is failing" required=#true
    argument "since" description="How far back to look, e.g. 1h"
    text "You are triaging {service}."
    text "Read beaver://runbook/oncall before taking any action."
    text "Look back {since} and report what you find before changing anything."
}

// An MCP App: an interactive widget a host renders in place of the tool's
// text result. The body is a FILE beside this guardfile, not `text` children,
// because a real widget is a few hundred KB of bundled script. Reading it once
// at startup reaches no network, so it opens no egress path the way an
// upstream-proxying resource would.
//
// `tool` is what makes a host fetch the widget at all: it puts
// `_meta.ui.resourceUri` on that projected tool. An app naming no tool, or
// naming one this spec does not mint, is a build error - a widget attached to
// nothing renders for nobody and lints identically to a working one.
//
// `visibility "app"` says the agent does not see the tool and the widget may
// still call it. That is a DECLARATION to the host, which owns the sandbox and
// the postMessage bridge; the enforceable bound is still the `can` grants
// below, which is the whole reason to serve a widget from a guarded server.
//
// Every csp list omitted means the host allows no origin at all, so a
// self-contained bundle needs no `csp` node. Declare only what the widget
// actually reaches.
app "thing-card" uri="ui://thing-card/mcp-app.html" file="widgets/things.html" prefers-border=#true {
    description "The thing this tool returned, as a card"
    tool "get_thing"
}

wrap ward mcp things {
    base-url "things.example/api/v1"

    auth bearer {
        value env "THINGS_API_TOKEN"
    }

    restrict owner matches "coilyco-*"

    // `describe` overrides the derived "Use this when the user wants to get
    // thing through the configured upstream service." Worth authoring whenever
    // a server ships a tool a model could confuse with a neighbour: say what
    // the tool covers AND what it does not, so the model can rule it out
    // rather than guess. Absent, the derived sentence still applies.
    can get thing {
        path "/owners/{owner}/things/{id}"
        describe "Fetch one thing by id, with its metadata. Returns the record only - does NOT create or modify anything; use create_thing for that."
    }

    can create thing {
        path "/owners/{owner}/things"
        body {
            field "title" type="string" required=#true
        }
    }
}
